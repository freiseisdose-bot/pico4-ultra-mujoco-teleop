<mujoco model="six_dof_robot">
  <option gravity="0 0 0"/>

  <worldbody>
    <geom type="plane" size="2 2 0.1"
          rgba="0.8 0.8 0.8 1"/>

    <body name="link1" pos="0 0 0.3">
      <joint name="joint1" type="hinge"
             axis="0 0 1" damping="2"/>
      <geom type="capsule"
            fromto="0 0 0 0 0 0.20"
            size="0.05" mass="1"
            rgba="0.2 0.5 0.9 1"/>

      <body name="link2" pos="0 0 0.20">
        <joint name="joint2" type="hinge"
               axis="0 1 0" damping="2"/>
        <geom type="capsule"
              fromto="0 0 0 0.25 0 0"
              size="0.04" mass="0.8"
              rgba="0.9 0.4 0.2 1"/>

        <body name="link3" pos="0.25 0 0">
          <joint name="joint3" type="hinge"
                 axis="0 1 0" damping="2"/>
          <geom type="capsule"
                fromto="0 0 0 0.22 0 0"
                size="0.035" mass="0.6"
                rgba="0.2 0.8 0.4 1"/>

          <body name="link4" pos="0.22 0 0">
            <joint name="joint4" type="hinge"
                   axis="1 0 0" damping="1"/>
            <geom type="capsule"
                  fromto="0 0 0 0.13 0 0"
                  size="0.03" mass="0.4"
                  rgba="0.8 0.3 0.8 1"/>

            <body name="link5" pos="0.13 0 0">
              <joint name="joint5" type="hinge"
                     axis="0 1 0" damping="1"/>
              <geom type="capsule"
                    fromto="0 0 0 0.10 0 0"
                    size="0.025" mass="0.3"
                    rgba="0.9 0.7 0.2 1"/>

              <body name="link6" pos="0.10 0 0">
                <joint name="joint6" type="hinge"
                       axis="1 0 0" damping="1"/>
                <geom type="capsule"
                      fromto="0 0 0 0.08 0 0"
                      size="0.02" mass="0.2"
                      rgba="0.3 0.8 0.9 1"/>

                <site name="end_effector"
                      pos="0.08 0 0"
                      size="0.025"
                      rgba="0 1 0 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position joint="joint1" kp="100"/>
    <position joint="joint2" kp="100"/>
    <position joint="joint3" kp="100"/>
    <position joint="joint4" kp="80"/>
    <position joint="joint5" kp="80"/>
    <position joint="joint6" kp="80"/>
  </actuator>
</mujoco>
